<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- NavHostFragment -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHostFragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <!-- Barre de navigation personnalisée -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_gravity="bottom"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@color/app_card"
        app:cardCornerRadius="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 1. Home -->
            <LinearLayout
                android:id="@+id/btnNavHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/navHome"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_app_logo"
                    app:tint="@color/app_text_secondary" />
                <TextView
                    android:id="@+id/tvNavHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/nav_home"
                    android:textSize="10sp"
                    android:fontFamily="@font/nunito_bold"
                    android:textColor="@color/app_text_secondary" />
            </LinearLayout>

            <!-- 2. Messages -->
            <LinearLayout
                android:id="@+id/btnNavMessages"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/navMessages"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_comment"
                    app:tint="@color/app_text_secondary" />
                <TextView
                    android:id="@+id/tvNavMessages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/nav_messages"
                    android:textSize="10sp"
                    android:fontFamily="@font/nunito_bold"
                    android:textColor="@color/app_text_secondary" />
            </LinearLayout>

            <!-- 3. Studio (Center) -->
            <LinearLayout
                android:id="@+id/btnNavStudio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_nav_studio">
                    <ImageView
                        android:id="@+id/navStudio"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_add_circle"
                        app:tint="@color/white" />
                </FrameLayout>
                <TextView
                    android:id="@+id/tvNavStudio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_studio"
                    android:textSize="10sp"
                    android:fontFamily="@font/nunito_bold"
                    android:textColor="@color/app_text_secondary" />
            </LinearLayout>

            <!-- 4. Network -->
            <LinearLayout
                android:id="@+id/btnNavNetwork"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/navNetwork"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_people"
                    app:tint="@color/app_text_secondary" />
                <TextView
                    android:id="@+id/tvNavNetwork"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/nav_network"
                    android:textSize="10sp"
                    android:fontFamily="@font/nunito_bold"
                    android:textColor="@color/app_text_secondary" />
            </LinearLayout>

            <!-- 5. Profile -->
            <LinearLayout
                android:id="@+id/btnNavProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/navProfile"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_default_avatar"
                    app:tint="@color/app_text_secondary" />
                <TextView
                    android:id="@+id/tvNavProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/nav_profile"
                    android:textSize="10sp"
                    android:fontFamily="@font/nunito_bold"
                    android:textColor="@color/app_text_secondary" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>