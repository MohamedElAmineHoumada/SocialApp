<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.Groupe15.SocialApp.ui.auth.LoginFragment"
        android:label="Connexion">
        <action
            android:id="@+id/action_login_to_feed"
            app:destination="@id/feedFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_login_to_forgotPassword"
            app:destination="@id/forgotPasswordFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.Groupe15.SocialApp.ui.auth.ForgotPasswordFragment"
        android:label="Reset Password" />

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.Groupe15.SocialApp.ui.auth.RegisterFragment"
        android:label="Inscription">
        <action
            android:id="@+id/action_register_to_feed"
            app:destination="@id/feedFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/feedFragment"
        android:name="com.Groupe15.SocialApp.ui.feed.FeedFragment"
        android:label="Feed">
        <action
            android:id="@+id/action_feed_to_profile"
            app:destination="@id/profileFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_feed_to_createPost"
            app:destination="@id/createPostFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.Groupe15.SocialApp.ui.profile.ProfileFragment"
        android:label="Profil">
        <argument
            android:name="uid"
            app:argType="string"
            android:defaultValue=""/>
        <action
            android:id="@+id/action_profile_to_editProfile"
            app:destination="@id/editProfileFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_profile_to_chat"
            app:destination="@id/chatFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_profile_to_settings"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.Groupe15.SocialApp.ui.profile.SettingsFragment"
        android:label="Paramètres" />

    <fragment
        android:id="@+id/createPostFragment"
        android:name="com.Groupe15.SocialApp.ui.post.CreatePostFragment"
        android:label="Créer un post"/>

    <fragment
        android:id="@+id/messagesFragment"
        android:name="com.Groupe15.SocialApp.ui.messages.MessagesFragment"
        android:label="Messages">
        <action
            android:id="@+id/action_messages_to_chat"
            app:destination="@id/chatFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.Groupe15.SocialApp.ui.profile.EditProfileFragment"
        android:label="Edit Profile"/>

    <fragment
        android:id="@+id/discoverFragment"
        android:name="com.Groupe15.SocialApp.ui.discover.DiscoverFragment"
        android:label="Discover" />

    <fragment
        android:id="@+id/networkFragment"
        android:name="com.Groupe15.SocialApp.ui.network.NetworkFragment"
        android:label="Réseau" />

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.Groupe15.SocialApp.ui.messages.ChatFragment"
        android:label="Chat">
        <argument
            android:name="chatId"
            app:argType="string" />
        <argument
            android:name="userName"
            app:argType="string" />
    </fragment>
    <!-- ONBOARDING FLOW -->
    <fragment
        android:id="@+id/onboardingWelcomeFragment"
        android:name="com.Groupe15.SocialApp.ui.auth.OnboardingWelcomeFragment"
        android:label="Welcome">
        <action
            android:id="@+id/action_welcome_to_dob"
            app:destination="@id/onboardingDobFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>

    <fragment
        android:id="@+id/onboardingDobFragment"
        android:name="com.Groupe15.SocialApp.ui.auth.OnboardingDobFragment"
        android:label="Date of Birth">
        <action
            android:id="@+id/action_dob_to_gender"
            app:destination="@id/onboardingGenderFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>

    <fragment
        android:id="@+id/onboardingGenderFragment"
        android:name="com.Groupe15.SocialApp.ui.auth.OnboardingGenderFragment"
        android:label="Gender">
        <action
            android:id="@+id/action_gender_to_interests"
            app:destination="@id/onboardingInterestsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>

    <fragment
        android:id="@+id/onboardingInterestsFragment"
        android:name="com.Groupe15.SocialApp.ui.auth.OnboardingInterestsFragment"
        android:label="Interests">
        <action
            android:id="@+id/action_interests_to_feed"
            app:destination="@id/feedFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/onboardingWelcomeFragment"
            app:popUpToInclusive="true"/>
    </fragment>

</navigation>